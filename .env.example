# Copiar a .env o generar secretos con: python scripts/configurar_local.py
# .env y .local/ nunca se publican. Las variables del entorno tienen prioridad.
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

DB_ENGINE=mysql
DB_NAME=senova
DB_USER=gesicom_app
DB_PASSWORD=replace-with-a-random-password
DB_HOST=127.0.0.1
DB_PORT=3307
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
REDIS_PASSWORD=replace-with-a-random-redis-password
REDIS_URL=redis://:replace-with-a-random-redis-password@127.0.0.1:6380/0

# SMTP del REMITENTE. Se aceptan destinatarios de cualquier dominio.
EMAIL_BACKEND=SENNOVA.email_backend.SMTPBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=santiagoocoy2025@gmail.com
DEFAULT_FROM_EMAIL=GESICOM <santiagoocoy2025@gmail.com>
EMAIL_HOST_PASSWORD=
# Gmail necesita una contraseña de aplicación (verificación en dos pasos), no la contraseña normal.
# Opcional: token SMTP XOAUTH2 vigente con renovación externa.
EMAIL_OAUTH2_ACCESS_TOKEN=

# Solo configurar si existe un proxy de confianza administrado por el despliegue.
TRUSTED_PROXY_IPS=
TRUST_PROXY_HTTPS=False
WEB_WORKERS=4
WEB_THREADS=2

# Redes compartidas: límite adicional por IP; también se limita cada identidad.
LOGIN_IP_LIMIT=2000
REGISTRATION_IP_LIMIT=2000
SESSION_IDLE_TIMEOUT=1800
